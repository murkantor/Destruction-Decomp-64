# Compile the SDL_gpu backend's shaders (port/fast3d/shaders) to SPIR-V, into
# one header of word arrays: port/fast3d/shaders/spirv.h. The header is in the
# repository, so a build without glslangValidator uses it as it is; with one,
# CMakeLists.txt runs this whenever a shader changes.
#   cmake -DGLSLANG=glslangValidator -DDIR=port/fast3d/shaders -DOUT=spirv.h -DTMP=dir -P spirv.cmake
set(shaders
    combiner_vert_spv combiner_vk.vert
    combiner_frag_spv combiner_vk.frag
    vi_vert_spv vi.vert
    vi_coverage_frag_spv vi_coverage.frag
    vi_blend_frag_spv vi_blend.frag)

set(text "/* Generated by cmake/spirv.cmake from the shaders here: do not edit */\n#include <stdint.h>\n")
list(LENGTH shaders n)
math(EXPR last "${n} - 1")
foreach(i RANGE 0 ${last} 2)
    math(EXPR j "${i} + 1")
    list(GET shaders ${i} name)
    list(GET shaders ${j} file)
    execute_process(
        COMMAND ${GLSLANG} -V --target-env vulkan1.0 --vn ${name} -o ${TMP}/${name}.h ${DIR}/${file}
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "glslangValidator failed on ${file}:\n${out}")
    endif()
    file(READ ${TMP}/${name}.h words)
    string(REPLACE "#pragma once" "" words "${words}")
    string(APPEND text "\n${words}")
endforeach()
file(WRITE ${OUT} "${text}")
